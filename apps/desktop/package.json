{
  "name": "@spacejanitor/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Adrian Birzu <adibirzu@gmail.com>",
  "description": "Electron desktop shell and tray app for SpaceJanitor.",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/generate-icons.mjs && tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "pack": "electron-builder --config electron-builder.yml --dir --publish never",
    "dist": "electron-builder --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@spacejanitor/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2"
  }
}
