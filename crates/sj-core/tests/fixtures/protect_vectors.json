      "unprotected": [
        "ext/deep/x/f",
        "ext/other/f"
      ]
    },
    {
      "name": "glob rule matches through a symlinked parent",
      "home": "home",
      "setup": [
        {
          "dir": "ext/projreal/secret"
        },
        {
          "dir": "home"
        },
        {
          "link": "home/proj",
          "target": "ext/projreal"
        }
      ],
      "options": {
        "glob": [
          "*/projreal/secret/*"
        ]
      },
      "protected": [
        "home/proj/secret/f",
        "ext/projreal/secret/f"
      ],
      "unprotected": [
        "home/proj/public/f"
      ]
    }
