          "link"
        ]
      },
      "protected": [
        "ext/real/src",
        "ws/link/src"
      ],
      "unprotected": [
        "ext/idle/src"
      ]
    },
    {
      "name": "exact rule with symlink then .. is resolved in OS order (reviewer repro R3-1)",
