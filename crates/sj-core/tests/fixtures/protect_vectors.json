          "dir": "home"
        },
        {
          "dir": "ws/keep"
        },
        {
          "dir": "ws/other"
        }
      ],
      "options": {
        "exact": [
          "./keep"
        ]
      },
      "protected": [
        "ws/keep/precious.txt",
        "ws/keep"
      ],
      "unprotected": [
        "ws/other/x"
      ]
    },
    {
