  "fs_cases": [
    {
      "name": "~/.ssh symlinked elsewhere: the real target stays protected (R2-B3)",
      "home": "home",
      "setup": [
        {
          "dir": "ext/real_ssh"
        },
        {
          "dir": "home"
        },
        {
          "link": "home/.ssh",
          "target": "ext/real_ssh"
        }
      ],
      "protected": [
        "ext/real_ssh/config",
        "ext/real_ssh"
      ],
      "unprotected": [
        "ext/other/file"
      ]
    },
    {
      "name": "~/Documents symlinked into the trash",
      "home": "home",
      "setup": [
        {
          "dir": "home/.Trash/Documents_real"
        },
        {
          "link": "home/Documents",
          "target": "home/.Trash/Documents_real"
        }
      ],
      "protected": [
        "home/.Trash/Documents_real/tax.pdf"
      ],
      "unprotected": [
        "home/.Trash/other.bin"
      ]
    },
    {
