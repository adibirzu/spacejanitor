          "ws_link"
        ]
      },
      "protected": [
        "ext/active_real/src"
      ],
      "unprotected": [
        "ext/idle/src"
      ]
    },
    {
      "name": "custom rules are additive only: they never allow what a built-in rule protects",
      "home": "home",
      "setup": [
        {
          "dir": "home/.ssh"
        }
      ],
      "options": {
        "exact": [
          "/nonexistent-allow"
        ],
        "glob": [
          "*.never-matches"
        ]
      },
      "protected": [
        "home/.ssh/id_x"
      ],
      "unprotected": []
    },
    {
      "name": "relative --exact rule is anchored to the cwd",
      "home": "home",
      "cwd": "ws",
      "setup": [
