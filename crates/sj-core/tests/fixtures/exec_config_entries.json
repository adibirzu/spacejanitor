    ["filter.lfs.smudge", "git-lfs smudge --skip -- %f"],
    ["filter.lfs.process", "git-lfs filter-process"],
    ["filter.lfs.process", "git-lfs filter-process --skip"],
    ["credential.helper", ""],
    ["credential.helper", "osxkeychain"],
    ["credential.helper", "store"],
